<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>okf</PackageId>
    <ToolCommandName>okf</ToolCommandName>
    <PackAsTool>true</PackAsTool>
    <Description>Open Knowledge Format (OKF) tool. Validates markdown bundles, emits okf.json, and builds the HTML reader.</Description>

    <!-- Hybrid tool package (same shape as ndx and dotnet-stop):
         dotnet pack           -> pointer okf, listing RuntimeIdentifierPackages
         dotnet pack -r any    -> framework-dependent okf.any (CoreCLR fallback)
         dotnet pack -r <rid>  -> Native AOT okf.<rid>
         ndx and dnx hop from the pointer to the best RID, then any.
         The any package rolls forward onto a newer installed runtime. -->
    <RollForward>LatestMajor</RollForward>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64;any</RuntimeIdentifiers>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <StackTraceSupport>true</StackTraceSupport>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'any'">
    <PublishAot>false</PublishAot>
    <StripSymbols>false</StripSymbols>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ConsoleAppFramework" Version="5.7.13" PrivateAssets="all" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="SharpYaml" Version="3.14.0" />
    <PackageReference Include="ThisAssembly.Resources" Version="2.1.5" PrivateAssets="all" />
    <PackageReference Include="Readme" Version="1.2.1" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\Google\viz.html" Link="Google/viz-template.html" Kind="Text" />
    <EmbeddedResource Include="..\Google\viz.css" Link="Google/viz-styles.css" Kind="Text" />
    <EmbeddedResource Include="..\Google\viz.js" Link="Google/viz-script.js" Kind="Text" />
    <EmbeddedResource Include="..\View\index.html" Link="View/view-template.html" Kind="Text" />
    <EmbeddedResource Include="..\View\view.css" Link="View/view-styles.css" Kind="Text" />
    <EmbeddedResource Include="..\View\view.js" Link="View/view-script.js" Kind="Text" />
    <EmbeddedResource Include="..\..\schemas\okf-0.1.json" Link="okf-0.1.json" Kind="Text" />
    <EmbeddedResource Include="..\..\schemas\okf-0.2.json" Link="okf-0.2.json" Kind="Text" />
    <EmbeddedResource Include="..\..\specs\okf-0.1.md" Link="Specs/okf-0.1.md" Kind="Text" />
    <EmbeddedResource Include="..\..\specs\okf-0.2.md" Link="Specs/okf-0.2.md" Kind="Text" />
    <EmbeddedResource Include="..\..\skills\okf\SKILL.md" Link="SKILL.md" Kind="Text" />
  </ItemGroup>
</Project>
